[
  {
    "name": "paragraph_spacing",
    "markdown": "First paragraph.\n\nSecond paragraph.",
    "expectContains": ["<p>First paragraph.</p>", "prose-spacer", "<p>Second paragraph.</p>"]
  },
  {
    "name": "unordered_list",
    "markdown": "- Alpha\n- Beta",
    "expectContains": ["<ul>", "<li>Alpha</li>", "<li>Beta</li>"]
  },
  {
    "name": "ordered_list",
    "markdown": "1. One\n2. Two",
    "expectContains": ["<ol>", "<li>One</li>"]
  },
  {
    "name": "heading_h2",
    "markdown": "## Section",
    "expectContains": ["<h2>Section</h2>"]
  },
  {
    "name": "heading_h1_emoji",
    "markdown": "# 🪐 S A T U R N — Community Rules",
    "expectContains": ["<h1>", "S A T U R N", "</h1>"]
  },
  {
    "name": "heading_h3_section",
    "markdown": "### 01 — Respect Everyone",
    "expectContains": ["<h3>", "01 — Respect Everyone", "</h3>"]
  },
  {
    "name": "bold_italic_triple",
    "markdown": "Welcome to ***S A T U R N***.",
    "expectContains": ["<strong>", "<em>", "S A T U R N"]
  },
  {
    "name": "blockquote",
    "markdown": "> Quoted line",
    "expectContains": ["<blockquote>", "Quoted line"]
  }
]
