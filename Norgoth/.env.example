# Norgoth — single product environment template.
# Copy to .env and fill in secrets. Never commit real credentials.

# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
NORGOTH_ENVIRONMENT=development
NORGOTH_LOG_LEVEL=INFO
NORGOTH_ENABLE_DOCS=true
# Optional release identifier (set by deploy to the git SHA).
# NORGOTH_RELEASE_SHA=
# Campaign Postgres durability (default true). Set false only for emergency rollback.
# NORGOTH_CAMPAIGN_PG_ENABLED=true
# Rebuild campaign queue/schedule indexes from Postgres when the worker starts.
# NORGOTH_CAMPAIGN_REHYDRATE_ON_START=true

# ------------------------------------------------------------------
# Persistence
# ------------------------------------------------------------------
# PostgreSQL for guilds / configuration / verification / audit logs.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
NORGOTH_DATABASE_URL=
NORGOTH_DATABASE_ECHO=false

# Redis for campaign queue, worker + bot heartbeats.
# Production Compose requires REDIS_PASSWORD and redis://:password@redis:6379/0.
NORGOTH_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------
# Discord application
# ------------------------------------------------------------------
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Bot token from the Discord Developer Portal (Bot tab). REQUIRED for the bot.
DISCORD_BOT_TOKEN=

# Dedicated shared secret for bot/worker → API internal routes. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Falls back to DISCORD_BOT_TOKEN during migration if unset.
NORGOTH_INTERNAL_TOKEN=

# Comma-separated Discord user IDs allowed to pause/resume the global campaign queue.
# Empty = nobody (except local auth-disabled stub).
NORGOTH_PLATFORM_ADMIN_IDS=

# OAuth2 credentials (OAuth2 tab). All three must be set together for
# member verification. The client secret also signs OAuth state payloads.
# Uncomment these in .env and paste the Client Secret from the Discord
# Developer Portal. REDIRECT_URI must match an OAuth2 redirect exactly
# (e.g. http://127.0.0.1:8000/api/v1/oauth/discord/callback). Until set,
# authorize endpoints return HTTP 503 with a clear message.
NORGOTH_DISCORD_CLIENT_ID=
NORGOTH_DISCORD_CLIENT_SECRET=
NORGOTH_DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/discord/callback
# Dashboard operator login callback (add this exact URI in Discord Developer Portal).
NORGOTH_DISCORD_DASHBOARD_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/discord/dashboard/callback
# Where OAuth should send operators after login.
NORGOTH_DASHBOARD_URL=http://127.0.0.1:3000
# Set true to require Login with Discord for Command Center routes.
# NORGOTH_AUTH_ENFORCED=true

# Optional public API base used in Discord verify-panel link buttons.
# Defaults to NORGOTH_API_URL or http://127.0.0.1:8000.
# NORGOTH_PUBLIC_API_URL=http://127.0.0.1:8000

# Dashboard origin for ticket transcript links in Discord DMs.
# NEXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:3000

# Comma-separated extra CORS origins (production defaults include www.norbot.io).
# NORGOTH_CORS_ORIGINS=https://www.norbot.io

# Production URL examples:
# NORGOTH_ENVIRONMENT=production
# NORGOTH_ENABLE_DOCS=false
# NORGOTH_AUTH_ENFORCED=true
# NORGOTH_DASHBOARD_URL=https://www.norbot.io
# NEXT_PUBLIC_DASHBOARD_URL=https://www.norbot.io
# NORGOTH_PUBLIC_API_URL=https://api.norbot.io
# NORGOTH_DISCORD_REDIRECT_URI=https://api.norbot.io/api/v1/oauth/discord/callback
# NORGOTH_DISCORD_DASHBOARD_REDIRECT_URI=https://api.norbot.io/api/v1/oauth/discord/dashboard/callback
# NORGOTH_API_INTERNAL_URL=http://api:8000
# NORGOTH_API_URL=http://api:8000
# Staging: https://test.norbot.io and https://api.test.norbot.io

# ------------------------------------------------------------------
# Stream / content notifications (optional)
# ------------------------------------------------------------------
# Twitch developer app credentials (https://dev.twitch.tv/console).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Shared EventSub webhook secret (also stored encrypted per subscription).
TWITCH_EVENTSUB_SECRET=

# YouTube Data API key (optional enrichment + @handle resolution).
YOUTUBE_API_KEY=

# Kick developer app credentials (https://kick.com/settings/developer).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# X / Twitter API bearer token (poll transport; filtered stream is Enterprise).
X_API_BEARER_TOKEN=

# Public HTTPS base URL used for platform webhook callbacks (WebSub/EventSub).
# NORGOTH_PUBLIC_API_URL=https://api.example.com

# AES-256-GCM key (Base64, exactly 32 bytes decoded) for Discord webhook tokens.
NORGOTH_WEBHOOK_ENCRYPTION_KEY=
# Optional AES-256-GCM key for operator Discord OAuth tokens in Redis.
# Falls back to NORGOTH_WEBHOOK_ENCRYPTION_KEY when unset.
# NORGOTH_OAUTH_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------
# Embed media uploads (local disk)
# ------------------------------------------------------------------
# Directory (relative to apps/api or absolute) where uploaded embed images are
# stored and served from /uploads. Defaults to var/uploads.
# NORGOTH_UPLOAD_DIR=var/uploads
# Max upload size in bytes (default 8 MiB; Discord embed image ceiling).
# NORGOTH_MAX_UPLOAD_BYTES=8388608
# NOTE: For images to render in Discord and on other devices, set
# NORGOTH_PUBLIC_API_URL to a URL the internet can reach; uploaded image URLs
# are built from it.

# ------------------------------------------------------------------
# Verification privacy keys
# ------------------------------------------------------------------
# Base64 HMAC-SHA256 key for IP hashes (>= 32 random bytes decoded).
NORGOTH_IP_HASH_KEY=
# Base64 AES-256-GCM key for IP encryption (exactly 32 bytes decoded).
NORGOTH_IP_ENCRYPTION_KEY=

# Optional proxycheck.io API key (keyless mode used when empty).
NORGOTH_PROXYCHECK_API_KEY=

# ------------------------------------------------------------------
# Dashboard (apps/dashboard/.env.local)
# ------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Server-side rewrite target for /norgoth-api/* (Compose: http://api:8000)
# NORGOTH_API_INTERNAL_URL=http://127.0.0.1:8000
