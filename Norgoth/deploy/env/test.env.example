# NorBot staging/test environment template.
# Copy to /opt/norbot/env/test.env (mode 600). Never commit real secrets.

NORGOTH_ENVIRONMENT=staging
NORGOTH_LOG_LEVEL=INFO
NORGOTH_ENABLE_DOCS=false
NORGOTH_AUTH_ENFORCED=true
NORGOTH_CAMPAIGN_PG_ENABLED=true
NORGOTH_CAMPAIGN_REHYDRATE_ON_START=true

POSTGRES_DB=norbot_test
POSTGRES_USER=norbot_test
POSTGRES_PASSWORD=change-me-test-strong

NORGOTH_DATABASE_URL=postgresql+psycopg://norbot_test:change-me-test-strong@postgres:5432/norbot_test
NORGOTH_REDIS_URL=redis://redis:6379/1

DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

NORGOTH_DISCORD_CLIENT_ID=
NORGOTH_DISCORD_CLIENT_SECRET=
NORGOTH_DISCORD_REDIRECT_URI=https://api.test.norbot.io/api/v1/oauth/discord/callback
NORGOTH_DISCORD_DASHBOARD_REDIRECT_URI=https://api.test.norbot.io/api/v1/oauth/discord/dashboard/callback
NORGOTH_DASHBOARD_URL=https://test.norbot.io
NEXT_PUBLIC_DASHBOARD_URL=https://test.norbot.io
NORGOTH_PUBLIC_API_URL=https://api.test.norbot.io
NORGOTH_API_INTERNAL_URL=http://api:8000
NORGOTH_API_URL=http://api:8000
NORGOTH_CORS_ORIGINS=https://test.norbot.io

NORGOTH_IP_HASH_KEY=
NORGOTH_IP_ENCRYPTION_KEY=
NORGOTH_WEBHOOK_ENCRYPTION_KEY=

NORGOTH_UPLOAD_DIR=/app/var/uploads
NORGOTH_MEDIA_STORAGE_BACKEND=local
