# NorBot production environment template.
# Copy to /opt/norbot/env/production.env (mode 600). Never commit real secrets.

NORGOTH_ENVIRONMENT=production
NORGOTH_LOG_LEVEL=INFO
NORGOTH_ENABLE_DOCS=false
NORGOTH_AUTH_ENFORCED=true
NORGOTH_CAMPAIGN_PG_ENABLED=true

POSTGRES_DB=norbot_prod
POSTGRES_USER=norbot
POSTGRES_PASSWORD=change-me-strong

# Async SQLAlchemy DSN (psycopg3)
NORGOTH_DATABASE_URL=postgresql+psycopg://norbot:change-me-strong@postgres:5432/norbot_prod
NORGOTH_REDIS_URL=redis://redis:6379/0

DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

NORGOTH_DISCORD_CLIENT_ID=
NORGOTH_DISCORD_CLIENT_SECRET=
NORGOTH_DISCORD_REDIRECT_URI=https://api.norbot.io/api/v1/oauth/discord/callback
NORGOTH_DISCORD_DASHBOARD_REDIRECT_URI=https://api.norbot.io/api/v1/oauth/discord/dashboard/callback
NORGOTH_DASHBOARD_URL=https://www.norbot.io
NEXT_PUBLIC_DASHBOARD_URL=https://www.norbot.io
NORGOTH_PUBLIC_API_URL=https://api.norbot.io
NORGOTH_API_INTERNAL_URL=http://api:8000
NORGOTH_API_URL=http://api:8000
NORGOTH_CORS_ORIGINS=https://www.norbot.io,https://norbot.io

NORGOTH_IP_HASH_KEY=
NORGOTH_IP_ENCRYPTION_KEY=
NORGOTH_WEBHOOK_ENCRYPTION_KEY=

NORGOTH_UPLOAD_DIR=/app/var/uploads
NORGOTH_MEDIA_STORAGE_BACKEND=local

# Optional platform credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
YOUTUBE_API_KEY=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
X_API_BEARER_TOKEN=
